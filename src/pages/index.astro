---
import Base from '../layouts/Base.astro';
import '../components/service-card.ts';
import { services } from '../data/services';
import { site } from '../data/site';
const slides = ['property', 'garden', 'computers', 'network'];
---
<Base title={`${site.name} – ${site.tagline}`}>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg slides" aria-hidden="true">
        {slides.map((s, i) => <img src={`/images/${s}.jpg`} alt="" fetchpriority={i === 0 ? 'high' : undefined} />)}
      </div>
      <div class="hero-copy">
        <p class="eyebrow">Reliable. Local. Done properly.</p>
        <h1 id="hero-title">{site.name}</h1>
        <p class="hero-subtitle">Property maintenance, gardening &amp; IT help for homes and businesses</p>
        <a class="button button-outline" href="/enquire/">Get a quote <span aria-hidden="true">›</span></a>
      </div>
    </section>

    <section class="block wrap" aria-labelledby="what">
      <p class="eyebrow">What we do</p>
      <h2 id="what">Three skills, one dependable call.</h2>
      <div class="tiles">
        {services.map((s) => <service-card href={`/services/${s.slug}/`} name={s.name} tagline={s.tagline} image={s.image} alt={s.imageAlt} />)}
      </div>
    </section>

    <section class="block wrap center divider">
      <p class="eyebrow">Ready to get started?</p>
      <h2>Tell us what needs <em>doing.</em></h2>
      <a class="button button-dark" href="/enquire/">Enquire or book <span aria-hidden="true">›</span></a>
    </section>
  </main>
</Base>
